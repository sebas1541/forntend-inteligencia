# Copy to .env and fill in. All from Google Cloud → APIs & Services → Credentials.

# Maps SDK key (Maps SDK for iOS + Android). Restrict to: com.sebas1541.quickplate
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Google Sign-In OAuth client IDs:
#  - iOS client   → bundle id com.sebas1541.quickplate
#  - Web client   → used by the backend to verify the ID token
#  - Android client (optional) → package com.sebas1541.quickplate + SHA-1
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=xxxxx.apps.googleusercontent.com
